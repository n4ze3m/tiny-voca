# Keep the build context small: training checkpoints are several GB.
.git/
.github/
.gitignore
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
data/
runs/
evaluation/
ops/
web/
node_modules/
tests/
*.pt
*.pth
*.wav
# Text assets must reach the image; the ONNX is downloaded and verified at build.
!server/assets/**
server/assets/model.onnx
.env
*.log
.pytest_cache/
